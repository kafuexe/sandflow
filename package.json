{
  "name": "sandflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Visual flow builder for sandboxed coding agents (auto + AI blocks) powered by @ai-hero/sandcastle",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-hero/sandcastle": ">=0.5.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
